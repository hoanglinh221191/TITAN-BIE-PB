-ff=amber99sb-ildn
-topo=../input/MOL.top
-nt=4
-1pdb=true
-n=../input/index.ndx
-g=1-13
-mol-1-type=protein
-mol-2-type=lig
-f=../input/complex_trajectory
-path-a=../input/lib_ff/
-path-n=../input/lib_ff/
-pbcn

-pbsa=true
-pbsa-components=complex,receptor,ligand
-pbsa-decomp=hybrid
-pbsa-residue-frames=off
-pbsa-ie=true
-pbsa-ie-min-samples=10
-pbsa-ie-block=auto
-pbsa-ie-filter-sigma=2.0
-pbsa-perf=detail
-pbsa-grid-reuse=off

-edecomp=true
-edecomp-source=pbsa
-edecomp-level=both
-edecomp-edge-top=50
-edecomp-rank-by=abs-mean

-pbe=bie
-pbe-bie-fast-operator=p1
-pbe-model=linear
-pbe-biomodel=pbe
-pbe-dielectric=two-dielectric
-pbe-int-diel=1.0
-pbe-ext-diel=80.0
-pbe-salt=0.15
-pbe-temp=298.15
-pbe-surface=vdw
-pbe-probe=1.4
-pbe-map=off
-pbe-focus=off
-pbe-multigrid=off
-pbe-max-iter=720
-pbe-rms=1e-4
-pbe-dphi=1e-4
-pbe-timing=detail

-pbe-bie-primary-surface=analytic-ses
-pbe-bie-ses-grid-spacing=1.25
-pbe-bie-discretization=node-patch
-pbe-bie-tree-leaf-size=64
-pbe-bie-opening-theta=0.45
-pbe-bie-near-integration=analytic_singular
-pbe-bie-quad-buffer=off
-pbe-bie-precond=fmm-nearfield-ilu0
-pbe-bie-precond-ilu-neighbor-cap=64
-pbe-bie-precond-ilu-drop-tol=0.0
-pbe-bie-precond-ilu-regularization=adaptive
-pbe-bie-precond-ilu-regularization-max=0.01
-pbe-bie-precond-memory-budget-mb=1024
-pbe-bie-gmres-restart=128
-pbe-bie-true-residual-probe=restart
-pbe-bie-true-residual-probe-scope=sampled
-pbe-bie-true-residual-sample-count=512
-pbe-bie-matvec-audit=sampled
-pbe-bie-matvec-audit-sample-count=512
