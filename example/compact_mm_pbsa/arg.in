-ff=amber99sb-ildn
-topo=../input/MOL.top
-nt=4
-1pdb=true
-n=../input/index.ndx
-g=1-13
-mol-1-type=protein
-mol-2-type=lig
-f=../input/complex_trajectory
-path-a=../input/lib_ff/
-path-n=../input/lib_ff/
-pbcn
-pbsa=true
-pbsa-components=complex,receptor,ligand
-pbsa-decomp=hybrid
-pbsa-ie=false
-pbsa-perf=detail
-edecomp=true
-edecomp-source=pbsa
-edecomp-level=both
-pbe=tabi
-pbe-model=linear
-pbe-int-diel=1.0
-pbe-ext-diel=80.0
-pbe-salt=0.15
-pbe-temp=298.15
-pbe-probe=1.4
-pbe-max-iter=720
-pbe-rms=1e-4
-pbe-tabi-sum=treecode
-pbe-tabi-fmm-m2l=single-matvec-analytic
-pbe-tabi-fmm-local=off
-pbe-tabi-primary-surface=analytic-ses
-pbe-tabi-ses-grid-spacing=1.25
-pbe-tabi-discretization=node-patch
-pbe-tabi-opening-theta=0.45
-pbe-tabi-near-integration=analytic_singular
-pbe-tabi-quad-buffer=off
-pbe-tabi-precond=fmm-nearfield-ilu0
-pbe-tabi-precond-ilu-neighbor-cap=64
-pbe-tabi-precond-ilu-regularization=adaptive
-pbe-tabi-precond-memory-budget-mb=1024
-pbe-tabi-gmres-restart=128
-pbe-tabi-true-residual-probe=restart
-pbe-tabi-true-residual-probe-scope=sampled
-pbe-tabi-true-residual-sample-count=512
-pbe-tabi-matvec-audit=sampled
-pbe-tabi-matvec-audit-sample-count=512
