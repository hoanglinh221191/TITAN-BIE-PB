# ============================================
# TITAN arg.in — Dimer AB42 + NSP11
# GBSA  |  PCA  |  Allostery
# ============================================

# ── Reference structure / topology ──
-s=complex.pdb
-common_topo=topol.top
-n=index.ndx

# ── Force field ──
-ff=AMBER14SB
-g=4-3

# ── Trajectory ──
-traj=md1.xtc
-dt=10000
-b=100000

# ── Energy settings ──
-eu=kCal/mol
-entropy

# ── PBC ──
-pbcn

# ── Analyses ──
-gbsa
-pca
-network
-allostery

# ── Threads ──
-nt=8
