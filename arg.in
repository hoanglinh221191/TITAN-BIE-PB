# ============================================
# TITAN arg.in - AWH single-walker starter
# RC-binned IFP along the biased coordinate
# ============================================

# Input files
-s=md1_snap0.pdb
-traj=awh1.xtc
-n=index.ndx
-common_topo=topol.top

# System definition
# Change -ff only if your topol.top is not AMBER14SB-based
-ff=AMBER14SB
-g=3-4
-mol-1-type=protein
-mol-2-type=protein

# Recommended trimming / stride for long AWH trajectories
#-b=400000
#-e=...
#-dt=...

# PBC handling
-pbcn
# If the chains are badly fragmented across the box, try this instead:
#-pbctopo

# Structural readouts that remain useful on the biased ensemble
-rms
-dssp
-hb

# Primary AWH workflow:
# read the reaction coordinate from awh1.xvg, bin frames along RC,
# then compute IFP occupancy by RC bin to interpret unbinding.
-awh-ifp
-awh-xvg=awh_xvg_single.txt
-awh-bins=24
-awh-out-prefix=awh_rep_bin

# Optional secondary context only
#-network
#-community=louvain
#-pca

# Exploratory only on biased AWH data; not the default analysis axis
#-tica
#-umap
#-msm

# Threads
#-nt=8
